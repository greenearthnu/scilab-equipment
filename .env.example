# =============================================
# Web (apps/web/.env) — คัดลอกไปใช้ที่ apps/web/.env
# =============================================
# DATABASE_URL ใช้ค่าเดียวกับ packages/db/.env (Prisma resolve relative กับ schema.prisma)
DATABASE_URL="file:./dev.db"
# สร้างด้วยคำสั่ง: openssl rand -base64 32
SESSION_SECRET="your-session-secret-here"

# สำหรับ Postgres/ผลิตจริง:
# DATABASE_URL="postgresql://user:password@host:5432/scilab?schema=public"

# สำหรับ Push Notification (production) — สร้างได้ที่ https://expo.dev/account/settings/access-tokens
# ไม่ต้องตั้งถ้าใช้ Expo Go สำหรับพัฒนา
# EXPO_ACCESS_TOKEN="your-expo-access-token"

# =============================================
# Mobile (apps/mobile/.env) — ตั้ง URL ของ web backend
# =============================================
# ใช้ IP เครื่องที่รัน web เมื่อทดสอบบนโทรศัพท์จริง
EXPO_PUBLIC_API_URL="http://localhost:3000"
