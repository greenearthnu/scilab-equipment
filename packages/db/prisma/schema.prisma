generator client {
  provider = "prisma-client-js"
}

// สำหรับพัฒนาเครื่อง: ใช้ SQLite (ไม่ต้องติดตั้งอะไร)
// สำหรับผลิตจริง: เปลี่ยน provider เป็น "postgresql" (เช่น Supabase)
// แล้วตั้ง DATABASE_URL เป็น connection string ของ Postgres
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  TEACHER
  LAB_ADMIN
  EXECUTIVE
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  CHECKED_OUT
  COMPLETED
}

enum InstrumentStatus {
  AVAILABLE
  MAINTENANCE
  DISABLED
}

enum BookingRequestType {
  RETURN
  EXTEND
}

enum BookingRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstrumentCategory {
  MICROSCOPE
  MEASURING
  CHEMICAL
  GLASSWARE
  ELECTRICAL
  OTHER
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         Role           @default(STUDENT)
  className    String?
  studentId    String?
  phone        String?
  avatarUrl    String?
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  bookings       Booking[]
  notifications  Notification[]
  usageLogs      UsageLog[]
  devices        Device[]
  approvedBy     Booking[]        @relation("Approver")
  requestedRequests BookingRequest[] @relation("RequestedBy")
  decidedRequests  BookingRequest[] @relation("DecidedBy")
  projects         Project[]      @relation("ProjectCreator")
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  pushToken String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Instrument {
  id             String             @id @default(cuid())
  name           String
  category       InstrumentCategory
  description    String?
  imageUrl       String?
  totalQuantity  Int                @default(1)
  availableCount Int                @default(1)
  status         InstrumentStatus   @default(AVAILABLE)
  location       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  bookings  Booking[]
  usageLogs UsageLog[]
}

model Booking {
  id           String        @id @default(cuid())
  userId       String
  instrumentId String
  date         DateTime
  startTime    String
  endTime      String
  purpose      String?
  status       BookingStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  evidenceUrl  String?
  reminderOffsetMinutes Int?
  reminderSentAt        DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  approvedBy User?           @relation("Approver", fields: [approvedById], references: [id])
  usageLogs  UsageLog[]
  requests   BookingRequest[]

  @@index([userId])
  @@index([date])
  @@index([instrumentId, date])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UsageLog {
  id           String    @id @default(cuid())
  bookingId    String
  userId       String
  instrumentId String
  checkedInAt  DateTime
  checkedOutAt DateTime?

  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([instrumentId])
}

model BookingRequest {
  id            String               @id @default(cuid())
  bookingId     String
  type          BookingRequestType
  reason        String?
  newEndTime    String?
  status        BookingRequestStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("RequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?   @relation("DecidedBy", fields: [decidedById], references: [id])

  @@index([bookingId])
  @@index([status])
  @@index([requestedById])
}

model Project {
  id           String   @id @default(cuid())
  title        String
  summary      String
  studentNames String
  className    String?
  teacherName  String?
  award        String?
  imageUrl     String?
  featured     Boolean  @default(false)
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy User? @relation("ProjectCreator", fields: [createdById], references: [id])

  @@index([published, featured])
  @@index([displayOrder])
}
