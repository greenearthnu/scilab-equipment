generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// สำหรับพัฒนาเครื่อง: ใช้ SQLite (ไม่ต้องติดตั้งอะไร)
// สำหรับผลิตจริง: เปลี่ยน provider เป็น "postgresql" (เช่น Supabase)
// แล้วตั้ง DATABASE_URL ใน prisma.config.ts เป็น connection string ของ Postgres
datasource db {
  provider = "sqlite"
}

enum Role {
  OWNER
  STUDENT
  TEACHER
  LAB_ADMIN
  EXECUTIVE
}

enum BookingStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  CHECKED_OUT
  COMPLETED
}

enum InstrumentStatus {
  AVAILABLE
  MAINTENANCE
  DISABLED
}

enum BookingRequestType {
  RETURN
  EXTEND
}

enum BookingRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InstrumentCategory {
  MICROSCOPE
  MEASURING
  CHEMICAL
  GLASSWARE
  ELECTRICAL
  OTHER
}

enum AwardLevel {
  GOLD
  SILVER
  BRONZE
  HONORABLE
  OTHER
}

enum ScoreLogSource {
  MANUAL
  EARLY_RETURN
  EVIDENCE
  UNLOCK
}

enum BookingRecurrence {
  NONE
  WEEKLY
  MONTHLY
}

enum WaitlistStatus {
  WAITING
  ACTIVE // ได้รับแจ้งเตือนว่าว่างแล้ว (รอผู้ใช้ไปจองเอง)
  EXPIRED
  CANCELLED
}

enum MaintenanceStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  role         Role           @default(STUDENT)
  className    String?
  studentId    String?
  phone        String?
  avatarUrl    String?
  isActive     Boolean        @default(true)
  score          Int            @default(100)
  telegramUserId   String?        @unique
  // รูปแบบการแจ้งเตือน Telegram ของผู้ใช้รายนี้: FULL | SHORT (null = ใช้ค่าเริ่มต้นจาก env TELEGRAM_MESSAGE_STYLE)
  telegramAlertStyle String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  bookings       Booking[]
  notifications  Notification[]
  usageLogs      UsageLog[]
  devices        Device[]
  approvedBy     Booking[]        @relation("Approver")
  requestedRequests BookingRequest[] @relation("RequestedBy")
  decidedRequests  BookingRequest[] @relation("DecidedBy")
  projects         Project[]      @relation("ProjectCreator")
  scoreLogs          ScoreLog[]       @relation("ScoreLogUser")
  performedScoreLogs ScoreLog[]       @relation("ScoreLogPerformedBy")
  auditLogs          AuditLog[]       @relation("AuditLogActor")
  waitlistEntries    WaitlistEntry[]
  maintenanceCreated MaintenanceRecord[] @relation("MaintenanceCreatedBy")
}

model ScoreLog {
  id            String          @id @default(cuid())
  userId        String
  change        Int
  scoreAfter    Int
  reason        String
  source        ScoreLogSource  @default(MANUAL)
  performedById String?
  createdAt     DateTime        @default(now())

  user        User? @relation("ScoreLogUser", fields: [userId], references: [id], onDelete: Cascade)
  performedBy User? @relation("ScoreLogPerformedBy", fields: [performedById], references: [id])

  @@index([userId, createdAt])
  @@index([performedById])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String?
  details    String?
  createdAt  DateTime @default(now())

  actor User? @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId])
  @@index([targetType, targetId])
}

model Device {
  id        String   @id @default(cuid())
  userId    String
  pushToken String   @unique
  platform  String   @default("ios")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Instrument {
  id             String             @id @default(cuid())
  name           String
  category       InstrumentCategory
  description    String?
  imageUrl       String?
  totalQuantity  Int                @default(1)
  availableCount Int                @default(1)
  status         InstrumentStatus   @default(AVAILABLE)
  location       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  bookings     Booking[]
  usageLogs    UsageLog[]
  waitlist     WaitlistEntry[]
  maintenance  MaintenanceRecord[]
}

model Booking {
  id           String        @id @default(cuid())
  userId       String
  instrumentId String
  date         DateTime
  startTime    String
  endTime      String
  purpose      String?
  status       BookingStatus @default(PENDING)
  approvedById String?
  approvedAt   DateTime?
  evidenceUrl  String?
  reminderOffsetMinutes Int?
  reminderSentAt        DateTime?
  recurrence        BookingRecurrence @default(NONE)
  recurrenceEndDate DateTime?
  recurrenceGroupId String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument      @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  approvedBy User?           @relation("Approver", fields: [approvedById], references: [id])
  usageLogs  UsageLog[]
  requests   BookingRequest[]

  @@index([userId])
  @@index([date])
  @@index([instrumentId, date])
}

model WaitlistEntry {
  id           String         @id @default(cuid())
  userId       String
  instrumentId String
  date         DateTime
  startTime    String
  endTime      String
  status       WaitlistStatus @default(WAITING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([instrumentId, date, status])
  @@index([userId])
}

model MaintenanceRecord {
  id           String            @id @default(cuid())
  instrumentId String
  title        String
  description  String?
  date         DateTime
  startTime    String
  endTime      String
  status       MaintenanceStatus @default(SCHEDULED)
  createdById  String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  createdBy  User?      @relation("MaintenanceCreatedBy", fields: [createdById], references: [id])

  @@index([instrumentId, date])
  @@index([instrumentId, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  type      String   @default("info")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UsageLog {
  id           String    @id @default(cuid())
  bookingId    String
  userId       String
  instrumentId String
  checkedInAt  DateTime
  checkedOutAt DateTime?

  booking    Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  instrument Instrument @relation(fields: [instrumentId], references: [id], onDelete: Cascade)

  @@index([instrumentId])
}

model BookingRequest {
  id            String               @id @default(cuid())
  bookingId     String
  type          BookingRequestType
  reason        String?
  newEndTime    String?
  status        BookingRequestStatus @default(PENDING)
  requestedById String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("RequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?   @relation("DecidedBy", fields: [decidedById], references: [id])

  @@index([bookingId])
  @@index([status])
  @@index([requestedById])
}

/** การตั้งค่าคะแนนการใช้งาน — มีแค่ 1 แถว (id = 1) แก้ได้ผ่านหน้า /settings */
model ScoreSettings {
  id               Int      @id @default(1)
  initialScore     Int      @default(100)
  minToBook        Int      @default(50)
  earlyReturnBonus Int      @default(5)
  evidenceBonus    Int      @default(5)
  unlockScore      Int      @default(100)
  updatedById      String?
  updatedAt        DateTime @updatedAt
}

model Project {
  id           String   @id @default(cuid())
  title        String
  summary      String
  studentNames String
  className    String
  teacherName  String
  year         Int      @default(2026)
  featured     Boolean  @default(false)
  displayOrder Int      @default(0)
  published    Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  createdBy User?         @relation("ProjectCreator", fields: [createdById], references: [id])
  awards    ProjectAward[]
  images    ProjectImage[]

  @@index([published, featured])
  @@index([year])
  @@index([displayOrder])
}

model ProjectImage {
  id           String   @id @default(cuid())
  projectId    String
  url          String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectAward {
  id        String     @id @default(cuid())
  projectId String
  title     String
  level     AwardLevel @default(OTHER)
  year      Int        @default(2026)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([level])
  @@index([year])
}
