{
  "name": "scilab-equipment",
  "version": "0.1.0",
  "private": true,
  "description": "ระบบจองเครื่องมือห้องปฏิบัติการวิทยาศาสตร์ (โรงเรียนมัธยม)",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --parallel --filter @scilab/web --filter @scilab/mobile dev",
    "dev:web": "pnpm --filter @scilab/web dev",
    "dev:mobile": "pnpm --filter @scilab/mobile start",
    "build": "pnpm --filter @scilab/web build",
    "db:generate": "pnpm --filter @scilab/db generate",
    "db:migrate": "pnpm --filter @scilab/db migrate",
    "db:migrate:deploy": "pnpm --filter @scilab/db migrate:deploy",
    "db:seed": "pnpm --filter @scilab/db seed",
    "db:use:sqlite": "pnpm --filter @scilab/db db:use:sqlite",
    "db:use:postgres": "pnpm --filter @scilab/db db:use:postgres",
    "db:smoke:postgres": "pnpm --filter @scilab/db exec tsx scripts/pg-smoke-test.ts",
    "postinstall": "pnpm --filter @scilab/db generate",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3"]
  }
}
