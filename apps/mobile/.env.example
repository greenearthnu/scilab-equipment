# URL ของ API ของเว็บ (เครื่องมือถือต้องเข้าถึงได้ เช่น http://192.168.x.x:3000)
# ⚠️ เปลี่ยนเป็น IP/LAN ของเครื่องที่รัน web เมื่อทดสอบบนเครื่องมือถือจริง
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Google OAuth — Client ID จาก Google Cloud Console
# (สร้างที่ Google Cloud Console -> APIs & Services -> Credentials)
# - EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID: ใช้ใน Expo Go / Web (Client ID แบบ Web application)
# - EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID: ใช้ในแอป Android (ต้องลงทะเบียน SHA-1 หลัง build ครั้งแรก)
# - EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID: ใช้ในแอป iOS
# หมายเหตุ: ต้องตั้ง GOOGLE_ANDROID_CLIENT_ID / GOOGLE_IOS_CLIENT_ID ใน apps/web/.env ด้วย
#           (server ตรวจ allowlist ของ aud — ไม่ตั้งจะถูกปฏิเสธ)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
