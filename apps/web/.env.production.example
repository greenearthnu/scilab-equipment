# ============================================================
# SciLab Booking — ตัวอย่าง env สำหรับ production (Vercel + Postgres)
# คัดลอกค่าที่ต้องการไปตั้งใน Vercel → Settings → Environment Variables
# (อย่า commit ค่าจริง — ไฟล์นี้เป็นตัวอย่างเท่านั้น)
# ============================================================

# --- ฐานข้อมูล (Postgres — Supabase / Neon / RDS) ---
# ต้องใช้ connection string แบบ postgres://... (สลับ provider อัตโนมัติจากรูปแบบ URL)
DATABASE_URL="postgresql://user:password@host:5432/scilab?sslmode=require"

# --- ความปลอดภัย ---
# สร้างด้วย: openssl rand -base64 32
SESSION_SECRET=""
# ใช้กัน cron endpoint (ใส่ใน Vercel Cron header เดียวกัน) — สร้างด้วย: openssl rand -hex 16
CRON_SECRET=""

# --- Google OAuth (Sign in with Google) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
# โดเมนอีเมลที่อนุญาต เช่น pccpl.ac.th
GOOGLE_ALLOWED_DOMAIN="school.ac.th"

# --- URL สาธารณะของเว็บ (ใช้สร้างลิงก์ในอีเมล/Telegram และ redirect ของ Google) ---
# ต้องเป็น https://... เสมอ (ไม่เช่นนั้นปุ่ม URL ใน Telegram จะไม่ถูกแนบ)
APP_PUBLIC_URL="https://your-domain.vercel.app"

# --- Telegram Bot (แจ้งเตือนผู้ดูแล) ---
TELEGRAM_BOT_TOKEN=""
# fallback เมื่อยังไม่มีผู้ดูแลคนไหนผูก Telegram User ID
TELEGRAM_CHAT_ID=""
# ใช้ยืนยัน webhook /api/telegram/webhook (ถ้าใช้ inline keyboard อนุมัติ/ปฏิเสธ)
TELEGRAM_WEBHOOK_SECRET=""
# รูปแบบข้อความเริ่มต้น: full (หลายบรรทัด) หรือ short (1 บรรทัด)
TELEGRAM_MESSAGE_STYLE="full"

# --- Email (SMTP) — nodemailer ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="SciLab Booking <no-reply@example.com>"

# --- ไม่จำเป็นใน production (เฉพาะ build ของ Expo) ---
# EXPO_ACCESS_TOKEN=""
