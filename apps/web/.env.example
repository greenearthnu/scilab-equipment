# --- Google OAuth (Sign in with Google) ---
# สร้าง OAuth Client ได้ที่ Google Cloud Console: APIs & Services -> Credentials
# ต้องลงทะเบียน Redirect URI: http://localhost:3000/api/auth/google/callback (dev) หรือ https://... (prod)
# GOOGLE_ALLOWED_DOMAIN = โดเมนอีเมลของโรงเรียน เช่น "pccpl.ac.th" (ค่าเริ่มต้น school.ac.th)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ALLOWED_DOMAIN=""

# --- แอป (web) ---
# URL สาธารณะของระบบ (https) — ใช้สร้าง redirect URI ของ Google + ลิงก์ในข้อความ Telegram
# ตั้งเมื่อใช้ reverse proxy (Caddyfile.example) หรือ tunnel (cloudflared/ngrok)
# ถ้าไม่ตั้ง ระบบจะใช้ Host/X-Forwarded-Host header ของ request จริง
APP_PUBLIC_URL=""

# --- ฐานข้อมูล / เซสชัน ---
# SQLite: "file:./prisma/dev.db" (ค่าเริ่มต้น) — production แนะนำ PostgreSQL
DATABASE_URL=""
# ใช้รันคำสั่ง encryption สำหรับ session cookie — สร้างด้วย: openssl rand -base64 32
SESSION_SECRET=""

# --- Push Notification (Expo) ---
# ฟรี — ใช้ Expo Push Service; app ฝั่งมือถือต้องรันด้วย Expo Go (dev) หรือ build ด้วย EAS
EXPO_ACCESS_TOKEN=""
EXPO_PROJECT_ID=""

# --- Email (SMTP) ---
# ฟรีถ้าใช้ Gmail SMTP (App Password): SMTP_HOST=smtp.gmail.com, SMTP_USER=<อีเมล>, SMTP_PASS=<App Password>
# ไม่ตั้ง → ระบบข้ามการส่งอีเมลเงียบ ๆ
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM=""

# --- Telegram Bot แจ้งเตือนผู้ดูแล (ฟรี ไม่จำกัดข้อความ) ---
# สร้าง bot: คุยกับ @BotFather ใน Telegram → /newbot → ได้ token
# หา chat_id: เพิ่ม bot เข้ากลุ่มผู้ดูแล แล้วส่งข้อความในกลุ่ม → เปิด https://api.telegram.org/bot<TOKEN>/getUpdates
#   chat.id ที่ขึ้นต้นด้วย -100... คือ id ของกลุ่ม (ใช้ค่านี้)
# ระบบจะส่งข้อความแจ้งผู้ดูแลเมื่อ: มีคำขอจองใหม่ / คำขอคืน-ขยายเวลา / คะแนนต่ำกว่าเกณฑ์ 50
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# (ไม่บังคับ) รูปแบบสรุปเริ่มต้นของข้อความแจ้งเตือน: full (หลายบรรทัด) หรือ short (1-2 บรรทัด)
# ผู้ดูแลแต่ละคนเลือกได้เองที่หน้า /profile (สรุปเต็ม/สั้น/ใช้ค่าเริ่มต้น) — ค่านี้ใช้กับ
# - ผู้ดูแลที่ยังไม่ได้เลือกในหน้า /profile
# - กรณีที่ยังไม่มีใครผูก Telegram User ID (ส่งไป TELEGRAM_CHAT_ID กลุ่ม)
TELEGRAM_MESSAGE_STYLE="full"

# (ไม่บังคับ) ใช้กับ webhook ของ Telegram — ตั้งเมื่อมี URL สาธารณะ (APP_PUBLIC_URL + tunnel/domain)
# กันคนนอกส่ง callback ปลอมเข้ามาใน /api/telegram/webhook
# ตั้ง webhook หลังรัน server: curl -X POST "https://api.telegram.org/bot<TELEGRAM_BOT_TOKEN>/setWebhook" \
#   -d "url=<APP_PUBLIC_URL>/api/telegram/webhook&secret_token=<ค่านี้>"
# ถ้าไม่ตั้ง (dev ใน LAN) ระบบจะใช้ poller (getUpdates) เอง ไม่ต้องใช้ webhook
TELEGRAM_WEBHOOK_SECRET=""

# --- Mobile (Expo) ---
EXPO_PUBLIC_API_URL=""
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
